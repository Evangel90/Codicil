// Copyright 2026 The Codicil Authors
//
// Codicil vault: a private dead man's switch for an estate.
//
// The owner proves they are alive with a passkey (Face ID / Touch ID) or a
// Cardano wallet signature. If they stop, the vault goes PENDING; after a
// challenge window in which the owner can still veto, it is RELEASED and each
// heir claims their share.
//
// Public ledger : phase, key *commitments*, the will's Merkle *root*,
//                 deadlines, counters, claim nullifiers.
// Private       : owner keys, the will (heirs, shares, unlock dates, backups),
//                 heir keys. They enter only through witnesses, on the user's
//                 own device.
//
// Lifecycle:
//   ARMED --timeout | k-of-n guardians | signed attestation--> PENDING --challenge window--> RELEASED
//     ^----------------- owner check-in during the challenge window (veto) --'
//
// "timeout" means the deadline plus an optional grace period has passed.

pragma language_version >= 0.28.0;

import CompactStandardLibrary;

// Passkey clientDataJSON lengths for the deployment origin:
// <113 + len(origin), 222 + len(origin)>. http://localhost:5173 → <134, 243>.
// sdk/src/config.ts holds the origin; a test fails if the two disagree.
import "lib/WebAuthn"<134, 243>;
import "lib/Cip30";

export enum Phase { armed, pending, released }

// One entry of the will. Only heirLeafHash(leaf) is ever used in a proof, and
// only the Merkle root of all leaves is stored on-chain.
export struct HeirLeaf {
  heirKeyCommit: Bytes<32>;    // edKeyCommitment(heir public key, salt)
  backupKeyCommit: Bytes<32>;  // same for the backup heir; all zeros = none
  shareBps: Uint<16>;          // basis points of the estate snapshot
  unlockAt: Uint<64>;          // earliest claim time (tranches, minors)
  salt: Bytes<32>;             // hides the leaf contents
}

export struct VaultConfig {
  ownerPasskeyCommit: Bytes<32>;  // passkeyCommitment(pk, salt); all zeros = disabled
  ownerEdCommit: Bytes<32>;       // edKeyCommitment(pk, salt); all zeros = disabled
  passkeyRpIdHash: Bytes<32>;     // SHA-256 of the WebAuthn relying party id
  willRoot: Field;
  firstDeadline: Uint<64>;        // unix seconds
  maxPeriod: Uint<64>;            // longest allowed check-in extension
  challengeWindow: Uint<64>;      // time the owner has to veto a trigger
  claimWindow: Uint<64>;          // after release, before backups may claim
  gracePeriod: Uint<64>;          // after a missed deadline, before the countdown may start; 0 = none
  tokenColor: Bytes<32>;          // unshielded token held by the vault
  guardianRoot: Field;            // Merkle root of guardianLeaf(secret) values
  guardianThreshold: Uint<8>;     // votes needed to start the countdown; 0 = no guardians
  attestorKeyCommit: Bytes<32>;   // attestorCommitment(pk, salt); all zeros = disabled
}

// ─── Public ledger ──────────────────────────────────────────────────────────
export ledger phase: Phase;
export ledger ownerPasskeyCommit: Bytes<32>;
export ledger ownerEdCommit: Bytes<32>;
export ledger passkeyRpIdHash: Bytes<32>;
export ledger willRoot: Field;
export ledger willVersion: Counter;
export ledger nonce: Counter;
export ledger deadline: Uint<64>;
export ledger maxPeriod: Uint<64>;
export ledger challengeWindow: Uint<64>;
export ledger claimWindow: Uint<64>;
export ledger gracePeriod: Uint<64>;
export ledger pendingUntil: Uint<64>;
export ledger releasedAt: Uint<64>;
export ledger tokenColor: Bytes<32>;
export ledger estateTotal: Uint<128>;     // deposits so far (docs/DECISIONS.md D1)
export ledger estateSnapshot: Uint<128>;  // frozen at release; shares are of this
export ledger estatePaid: Uint<128>;      // sum of all claims; never exceeds the snapshot
export ledger claimNullifiers: Set<Bytes<32>>;
export ledger guardianRoot: Field;
export ledger guardianThreshold: Uint<8>;
export ledger guardianRound: Counter;     // bumped by every owner check-in
export ledger guardianVotes: Counter;     // votes in the current round
export ledger guardianNullifiers: Set<Bytes<32>>;
export ledger attestorKeyCommit: Bytes<32>;

// ─── Witnesses (TypeScript in sdk/src/witnesses.ts; run on the user's device)
witness ownerPasskey(): Secp256r1Point;
witness ownerPasskeySalt(): Bytes<32>;
witness ownerPasskeyAssertion(digest: Bytes<32>): WebAuthnAssertion;
witness ownerEdKey(): Curve25519Point;
witness ownerEdSalt(): Bytes<32>;
witness ownerEdSignature(digest: Bytes<32>): Cip30Signature;
witness claimantLeaf(): HeirLeaf;
witness claimantLeafPath(leafHash: Bytes<32>): MerkleTreePath<10, Bytes<32>>;
witness claimantSecretKey(): Curve25519Scalar;
witness claimantKeySalt(): Bytes<32>;
witness payoutDivision(snapshot: Uint<128>, bps: Uint<16>): [Uint<128>, Uint<16>];
witness guardianSecret(): Bytes<32>;
witness guardianPath(leaf: Bytes<32>): MerkleTreePath<10, Bytes<32>>;
witness attestorKey(): Secp256r1Point;
witness attestorSalt(): Bytes<32>;
witness attestorSignature(digest: Bytes<32>): Secp256r1EcdsaSignature;

// ─── Constructor ────────────────────────────────────────────────────────────
constructor(config: VaultConfig) {
  const c = disclose(config);
  assert(c.ownerPasskeyCommit != default<Bytes<32>> || c.ownerEdCommit != default<Bytes<32>>,
         "vault needs an owner key");
  assert(c.maxPeriod > 0 && c.challengeWindow > 0, "invalid vault settings");
  // Grace is for a late check-in, not a second check-in period (D15).
  assert(c.gracePeriod <= c.maxPeriod, "grace period too long");
  ownerPasskeyCommit = c.ownerPasskeyCommit;
  ownerEdCommit = c.ownerEdCommit;
  passkeyRpIdHash = c.passkeyRpIdHash;
  willRoot = c.willRoot;
  deadline = c.firstDeadline;
  maxPeriod = c.maxPeriod;
  challengeWindow = c.challengeWindow;
  claimWindow = c.claimWindow;
  gracePeriod = c.gracePeriod;
  tokenColor = c.tokenColor;
  guardianRoot = c.guardianRoot;
  guardianThreshold = c.guardianThreshold;
  attestorKeyCommit = c.attestorKeyCommit;
  phase = Phase.armed;
}

// ─── Pure helpers (exported so TypeScript never re-implements hashing) ──────
export pure circuit passkeyCommitment(pk: Secp256r1Point, salt: Bytes<32>): Bytes<32> {
  return persistentCommit<Vector<3, Bytes<32>>>(
    [pad(32, "codicil:passkey:v1"),
     secp256r1PointX(pk) as Bytes<32>,
     secp256r1PointY(pk) as Bytes<32>],
    salt);
}

export pure circuit edKeyCommitment(pk: Curve25519Point, salt: Bytes<32>): Bytes<32> {
  return persistentCommit<Vector<3, Bytes<32>>>(
    [pad(32, "codicil:edkey:v1"),
     curve25519PointX(pk) as Bytes<32>,
     curve25519PointY(pk) as Bytes<32>],
    salt);
}

export pure circuit heirLeafHash(leaf: HeirLeaf): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>(
    [pad(32, "codicil:heirleaf:v1"), persistentHash<HeirLeaf>(leaf)]);
}

// What the owner signs to prove life: bound to this vault, the new deadline
// and the replay nonce (docs/DECISIONS.md D5).
export pure circuit aliveDigest(vault: Bytes<32>, next: Uint<64>, n: Uint<64>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>(
    [pad(32, "codicil:alive:v1"), vault, next as Bytes<32>, n as Bytes<32>]);
}

// What the owner signs to replace the will.
export pure circuit willUpdateDigest(vault: Bytes<32>, newRoot: Field, n: Uint<64>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>(
    [pad(32, "codicil:will:v1"), vault, newRoot as Bytes<32>, n as Bytes<32>]);
}

// One per will leaf, shared by the heir and their backup so only one can claim.
export pure circuit claimNullifier(vault: Bytes<32>, leafHash: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>(
    [pad(32, "codicil:claim:v1"), vault, leafHash]);
}

// A guardian's leaf in the guardian tree. The guardian keeps `secret`.
export pure circuit guardianLeaf(secret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "codicil:guardian:v1"), secret]);
}

// One vote per guardian per round, unlinkable to the guardian and across vaults.
export pure circuit guardianNullifier(vault: Bytes<32>, secret: Bytes<32>, round: Uint<64>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>(
    [pad(32, "codicil:guardian-vote:v1"), vault, secret, round as Bytes<32>]);
}

export pure circuit attestorCommitment(pk: Secp256r1Point, salt: Bytes<32>): Bytes<32> {
  return persistentCommit<Vector<3, Bytes<32>>>(
    [pad(32, "codicil:attestor:v1"),
     secp256r1PointX(pk) as Bytes<32>,
     secp256r1PointY(pk) as Bytes<32>],
    salt);
}

// What an attestor signs to declare the owner dead. Bound to the round, so
// any owner check-in voids attestations signed before it.
export pure circuit attestationDigest(vault: Bytes<32>, round: Uint<64>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>(
    [pad(32, "codicil:attestation:v1"), vault, round as Bytes<32>]);
}

// ─── Owner authentication ───────────────────────────────────────────────────
// The owner circuits read each ledger field once, into a `const`. A ledger
// read costs about 13 rows, and the wallet check-in fills its circuit size
// (2^17 rows) to the last row: one row more doubles its prover key
// (docs/VALIDATION.md, "Circuit headroom").
circuit approvedByPasskey(digest: Bytes<32>): [] {
  const pk = ownerPasskey();
  const commit = ownerPasskeyCommit;
  assert(commit != default<Bytes<32>>
      && passkeyCommitment(pk, ownerPasskeySalt()) == commit, "unknown owner key");
  assert(webauthnVerify(ownerPasskeyAssertion(digest), digest, passkeyRpIdHash, pk),
         "bad owner signature");
}

circuit approvedByWallet(digest: Bytes<32>): [] {
  const pk = ownerEdKey();
  const commit = ownerEdCommit;
  assert(commit != default<Bytes<32>>
      && edKeyCommitment(pk, ownerEdSalt()) == commit, "unknown owner key");
  assert(cip30Verify(ownerEdSignature(digest), digest, pk), "bad owner signature");
}

// ─── Check-in (proof of life) ───────────────────────────────────────────────
// The moment the timeout opens: the deadline plus the grace period. Until
// then the owner can still check in normally and nobody can start the
// countdown by timeout. With no grace period it is the deadline itself.
circuit graceEnd(): Uint<64> {
  return (deadline + gracePeriod) as Uint<64>;
}

circuit checkInPreconditions(p: Phase, next: Uint<64>): [] {
  assert(p != Phase.released, "vault already released");
  if (p == Phase.armed) {
    assert(blockTimeLt(graceEnd()), "switch already expired");
  }
  assert(blockTimeLt(next), "deadline must be in the future");
  // next <= now + maxPeriod, measured from now rather than from the old
  // deadline: otherwise repeated check-ins could push the deadline arbitrarily
  // far, and a long challenge window could leave the owner unable to veto
  // (found by the property tests; docs/DECISIONS.md D9).
  const longest = maxPeriod;
  const earliest = next > longest ? (next - longest) as Uint<64> : 0 as Uint<64>;
  assert(blockTimeGte(earliest), "deadline too far");
}

circuit applyCheckIn(p: Phase, next: Uint<64>): [] {
  deadline = next;
  nonce.increment(1);
  // Proof of life voids every guardian vote and attestation made so far
  // (docs/DECISIONS.md D13), not just those that triggered a countdown.
  guardianRound.increment(1);
  guardianVotes.resetToDefault();
  if (p == Phase.pending) {
    phase = Phase.armed;   // owner veto during the challenge window
  }
}

export circuit checkInPasskey(nextDeadline: Uint<64>): [] {
  const next = disclose(nextDeadline);
  const p = phase;
  checkInPreconditions(p, next);
  approvedByPasskey(aliveDigest(kernel.self().bytes, next, nonce));
  applyCheckIn(p, next);
}

export circuit checkInEd25519(nextDeadline: Uint<64>): [] {
  const next = disclose(nextDeadline);
  const p = phase;
  checkInPreconditions(p, next);
  approvedByWallet(aliveDigest(kernel.self().bytes, next, nonce));
  applyCheckIn(p, next);
}

// ─── Will update ────────────────────────────────────────────────────────────
circuit willUpdatePreconditions(): [] {
  assert(phase == Phase.armed, "will locked");
  assert(blockTimeLt(deadline), "switch already expired");
}

circuit applyWillUpdate(root: Field): [] {
  willRoot = root;
  willVersion.increment(1);
  nonce.increment(1);
  // Notice for heirs' apps: every letter issued before this is out of date
  // (its Merkle path leads to the old root). The event carries no payload;
  // the new root and version are already on the ledger.
  emit(Misc { name: pad(32, "codicil:will-changed:v1"), payload: default<Bytes<256>> });
}

export circuit updateWillPasskey(newRoot: Field): [] {
  const root = disclose(newRoot);
  willUpdatePreconditions();
  approvedByPasskey(willUpdateDigest(kernel.self().bytes, root, nonce));
  applyWillUpdate(root);
}

export circuit updateWillEd25519(newRoot: Field): [] {
  const root = disclose(newRoot);
  willUpdatePreconditions();
  approvedByWallet(willUpdateDigest(kernel.self().bytes, root, nonce));
  applyWillUpdate(root);
}

// ─── Funding and release ────────────────────────────────────────────────────
export circuit deposit(amount: Uint<128>): [] {
  assert(phase == Phase.armed, "vault closed");
  const a = disclose(amount);
  receiveUnshielded(tokenColor, a);
  estateTotal = (estateTotal + a) as Uint<128>;
}

circuit startChallenge(start: Uint<64>): [] {
  phase = Phase.pending;
  pendingUntil = (start + challengeWindow) as Uint<64>;
}

// `asOf` must be within the last 15 minutes, so a trigger cannot backdate the
// challenge window to shorten the owner's time to veto.
circuit freshTimestamp(asOf: Uint<64>): [] {
  assert(blockTimeGte(asOf), "stale timestamp");
  assert(blockTimeLt((asOf + 900) as Uint<64>), "stale timestamp");
}

// Anyone may start the countdown once the owner has missed their deadline and
// the grace period, if any, is over. The challenge window is measured from the
// end of the grace period, so a long grace never shortens the time to veto.
export circuit triggerTimeout(): [] {
  assert(phase == Phase.armed, "not armed");
  assert(blockTimeGte(deadline), "owner is still alive");
  const opens = graceEnd();
  assert(blockTimeGte(opens), "grace period open");
  startChallenge(opens);
}

// A hidden guardian votes that the owner has died. When `guardianThreshold`
// votes are in, the countdown starts, whatever the deadline. Nobody learns
// which guardians voted.
export circuit guardianAttest(asOf: Uint<64>): [] {
  const t = disclose(asOf);
  assert(phase == Phase.armed, "not armed");
  assert(guardianThreshold > 0, "no guardians");
  freshTimestamp(t);

  const secret = guardianSecret();
  const leaf = guardianLeaf(secret);
  const path = guardianPath(leaf);
  assert(path.leaf == leaf, "not a guardian");
  assert(merkleTreePathRootNoLeafHash<10>(path).field == guardianRoot, "not a guardian");

  const nul = disclose(guardianNullifier(kernel.self().bytes, secret, guardianRound));
  assert(!guardianNullifiers.member(nul), "already voted");
  guardianNullifiers.insert(nul);
  guardianVotes.increment(1);
  if (guardianVotes >= guardianThreshold) {
    startChallenge(t);
  }
}

// A trusted attestor (e.g. a notary or death-registry service) signs that the
// owner has died; anyone holding that attestation can start the countdown.
export circuit triggerAttestation(asOf: Uint<64>): [] {
  const t = disclose(asOf);
  assert(phase == Phase.armed, "not armed");
  freshTimestamp(t);
  const pk = attestorKey();
  assert(attestorKeyCommit != default<Bytes<32>>
      && attestorCommitment(pk, attestorSalt()) == attestorKeyCommit, "unknown attestor");
  const digest = attestationDigest(kernel.self().bytes, guardianRound);
  assert(secp256r1EcdsaVerify(digest, attestorSignature(digest), pk), "bad attestation");
  startChallenge(t);
}

export circuit finalizeRelease(): [] {
  assert(phase == Phase.pending, "not pending");
  assert(blockTimeGte(pendingUntil), "challenge window open");
  phase = Phase.released;
  releasedAt = pendingUntil;
  estateSnapshot = estateTotal;
  emit(Misc { name: pad(32, "codicil:released:v1"), payload: default<Bytes<256>> });
}

// Hook for other contracts: "has this vault been released?" (gate V12).
// kernel.caller() is only meaningful for contract callers, so users are rejected.
export circuit isReleasedForContract(): Boolean {
  const caller = kernel.caller();
  assert(caller.is_some && caller.value.is_left, "callable by contracts only");
  return phase == Phase.released;
}

// ─── Claims ─────────────────────────────────────────────────────────────────
// Proves, without revealing which one, that the claimant's leaf is in the will.
circuit provenLeaf(): [HeirLeaf, Bytes<32>] {
  assert(phase == Phase.released, "vault not released");
  const leaf = claimantLeaf();
  const leafHash = heirLeafHash(leaf);
  const path = claimantLeafPath(leafHash);
  // Two asserts, not `&&`: a short-circuit would branch on private data.
  assert(path.leaf == leafHash, "not in will");
  assert(merkleTreePathRootNoLeafHash<10>(path).field == willRoot, "not in will");
  return [leaf, leafHash];
}

// Commitment to the key the claimant holds (they prove knowledge of its secret).
circuit claimantKeyCommit(): Bytes<32> {
  return edKeyCommitment(ecMulGenerator(claimantSecretKey()), claimantKeySalt());
}

circuit pay(leaf: HeirLeaf, leafHash: Bytes<32>, recipient: UserAddress): [] {
  assert(blockTimeGte(disclose(leaf.unlockAt)), "share still locked");

  const nul = disclose(claimNullifier(kernel.self().bytes, leafHash));
  assert(!claimNullifiers.member(nul), "already claimed");
  claimNullifiers.insert(nul);

  // No integer division in Compact: the witness supplies q and r, the circuit
  // checks q * 10000 + r == snapshot * bps with r < 10000 (D2).
  const [q, r] = payoutDivision(estateSnapshot, leaf.shareBps);
  assert(q * 10000 + r == estateSnapshot * leaf.shareBps && r < 10000, "bad payout math");
  const amount = disclose(q);
  assert(estatePaid + amount <= estateSnapshot, "estate exhausted");
  estatePaid = (estatePaid + amount) as Uint<128>;

  sendUnshielded(tokenColor, amount, right<ContractAddress, UserAddress>(disclose(recipient)));
}

export circuit claim(recipient: UserAddress): [] {
  const [leaf, leafHash] = provenLeaf();
  assert(claimantKeyCommit() == leaf.heirKeyCommit, "not the heir");
  pay(leaf, leafHash, recipient);
}

// A backup heir may claim a share its primary heir left unclaimed after the
// claim window. Same nullifier, so at most one of the two is ever paid.
export circuit claimAsBackup(recipient: UserAddress): [] {
  const [leaf, leafHash] = provenLeaf();
  assert(leaf.backupKeyCommit != default<Bytes<32>>
      && claimantKeyCommit() == leaf.backupKeyCommit, "not the backup heir");
  assert(blockTimeGte((releasedAt + claimWindow) as Uint<64>), "primary claim window open");
  pay(leaf, leafHash, recipient);
}
