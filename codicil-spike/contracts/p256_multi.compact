//
// Validation gate V5: how many secp256r1 (P-256) ECDSA checks fit in one
// circuit? Each circuit touches the ledger so a full compile produces proving
// keys whose size and generation time we can record in docs/VALIDATION.md.

pragma language_version >= 0.28.0;

import CompactStandardLibrary;

export ledger verified: Counter;

export circuit verify1(
  d1: Bytes<32>, s1: Secp256r1EcdsaSignature, k1: Secp256r1Point
): [] {
  assert(secp256r1EcdsaVerify(d1, s1, k1), "bad signature 1");
  verified.increment(1);
}

export circuit verify2(
  d1: Bytes<32>, s1: Secp256r1EcdsaSignature, k1: Secp256r1Point,
  d2: Bytes<32>, s2: Secp256r1EcdsaSignature, k2: Secp256r1Point
): [] {
  assert(secp256r1EcdsaVerify(d1, s1, k1), "bad signature 1");
  assert(secp256r1EcdsaVerify(d2, s2, k2), "bad signature 2");
  verified.increment(2);
}

export circuit verify3(
  d1: Bytes<32>, s1: Secp256r1EcdsaSignature, k1: Secp256r1Point,
  d2: Bytes<32>, s2: Secp256r1EcdsaSignature, k2: Secp256r1Point,
  d3: Bytes<32>, s3: Secp256r1EcdsaSignature, k3: Secp256r1Point
): [] {
  assert(secp256r1EcdsaVerify(d1, s1, k1), "bad signature 1");
  assert(secp256r1EcdsaVerify(d2, s2, k2), "bad signature 2");
  assert(secp256r1EcdsaVerify(d3, s3, k3), "bad signature 3");
  verified.increment(3);
}
