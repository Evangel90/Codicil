# Codicil gate V14: settings for the end-to-end run on a real Midnight network.
#
# Copy to `.env` (which is gitignored) and fill in what you need, or let
# `npm run preprod:init` create `.env` with a fresh throwaway wallet seed.
# Never put a real wallet's recovery phrase or seed here. See docs/PREPROD.md.

# Which network to use: preprod (default), preview, or undeployed (a local network).
# Preview needs no Blockfrost token and is the fallback if Blockfrost is a problem.
MIDNIGHT_NETWORK=preprod

# Blockfrost project ID for a "Midnight Preprod" project (https://blockfrost.io).
# It starts with "nightpreprod". Needed for preprod only. Treat it as a secret.
BLOCKFROST_PROJECT_ID=

# Seed of the throwaway test wallet: 64 hex characters.
# Leave empty and run `npm run preprod:init`; it fills this in and never prints it.
WALLET_SEED=

# The local proof server (Docker). This is the default.
# PROOF_SERVER_URL=http://localhost:6300

# Timers, in seconds. The defaults are the shortest that leave room for each
# transaction to be proven and included; see preprod/src/timers.ts.
# CODICIL_FIRST_DEADLINE_S=1200
# CODICIL_MAX_PERIOD_S=1200
# CODICIL_FINAL_PERIOD_S=300
# CODICIL_CHALLENGE_S=120
# CODICIL_CLAIM_WINDOW_S=600

# Amounts, in tNIGHT, and the DUST the wallet must hold before a run starts.
# CODICIL_DEPOSIT=10
# CODICIL_ESCROW_DEPOSIT=5
# CODICIL_MIN_DUST=20

# A self-hosted node and indexer, instead of the public endpoints.
# MIDNIGHT_NODE_URL=http://localhost:9944
# MIDNIGHT_INDEXER_URL=http://localhost:8088/api/v4/graphql
# MIDNIGHT_INDEXER_WS_URL=ws://localhost:8088/api/v4/graphql/ws
